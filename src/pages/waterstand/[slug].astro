---
import fs from "node:fs";
import path from "node:path";
import Base from "../../layouts/Base.astro";
import WaterstandGrafiek from "../../components/WaterstandGrafiek.astro";
import { tijd, dag, meter, graden, metTijd } from "../../lib/format.js";

export function getStaticPaths() {
  const root = process.cwd();
  const locaties = JSON.parse(fs.readFileSync(path.join(root, "data/locaties.json"), "utf8"));
  const metPagina = locaties.filter((l) => !l.rws?.getij && l.rws?.waterstand && fs.existsSync(path.join(root, `data/metingen/${l.slug}.json`)));
  return metPagina.map((loc) => ({
    params: { slug: loc.slug },
    props: { loc, data: JSON.parse(fs.readFileSync(path.join(root, `data/metingen/${loc.slug}.json`), "utf8")), andere: metPagina.filter((l) => l.slug !== loc.slug) },
  }));
}

const { loc, data, andere } = Astro.props;
const ws = data.waterstand;
const reeks = ws?.reeks ?? [];
const nu = ws ? Date.parse(ws.t) : null;
const dagGeleden = reeks.length ? reeks.reduce((a, b) => (Math.abs(Date.parse(b.t) - (nu - 864e5)) < Math.abs(Date.parse(a.t) - (nu - 864e5)) ? b : a)) : null;
const delta = ws && dagGeleden && Math.abs(Date.parse(dagGeleden.t) - (nu - 864e5)) < 3 * 3600e3 ? Math.round(ws.v - dagGeleden.v) : null;
const trend = delta === null ? null : Math.abs(delta) < 5 ? "stabiel" : delta > 0 ? "stijgend" : "dalend";
const weekMin = reeks.length ? reeks.reduce((a, b) => (b.v < a.v ? b : a)) : null;
const weekMax = reeks.length ? reeks.reduce((a, b) => (b.v > a.v ? b : a)) : null;
const temp = data.temperatuur;
const tempBij = temp && loc.rws?.temperatuur?.km > 2 ? (temp.meetpuntNaam || loc.rws.temperatuur.naam) : null;
const isMeer = loc.type === "meer";
const titel = `Waterstand ${loc.naam} vandaag – actueel ${isMeer ? "peil" : "en verloop"}`;
const omschrijving = ws
  ? `Waterstand ${loc.naam}: ${meter(ws.v)} (gemeten ${tijd(ws.t)})${trend ? `, ${trend}` : ""}. Verloop van de afgelopen 7 dagen, elk uur bijgewerkt met data van Rijkswaterstaat.`
  : `Actuele waterstand ${loc.naam}, elk uur bijgewerkt met data van Rijkswaterstaat.`;
const faq = [
  ws && { v: `Wat is de waterstand bij ${loc.naam}?`, a: `De laatst gemeten waterstand bij ${loc.naam} is ${meter(ws.v)} (${dag(ws.t)} om ${tijd(ws.t)}).${delta !== null ? ` Dat is ${Math.abs(delta)} cm ${delta >= 0 ? "hoger" : "lager"} dan 24 uur eerder.` : ""}` },
  weekMin && { v: `Hoe veranderde de waterstand de afgelopen week?`, a: `De afgelopen 7 dagen lag de waterstand tussen ${meter(weekMin.v)} en ${meter(weekMax.v)}.` },
  temp && { v: `Wat is de watertemperatuur bij ${loc.naam}?`, a: `De laatst gemeten watertemperatuur is ${graden(temp.v)}${tempBij ? ` (gemeten bij ${tempBij})` : ""}.` },
].filter(Boolean);
const jsonLd = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${Astro.site}` },
    { "@type": "ListItem", position: 2, name: "Waterstanden", item: `${Astro.site}waterstand/` },
    { "@type": "ListItem", position: 3, name: loc.naam, item: `${Astro.site}waterstand/${loc.slug}` },
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<Base title={titel} description={omschrijving} canonical={`/waterstand/${loc.slug}`} jsonLd={jsonLd}>
  <nav class="kruimel muted"><a href="/">Home</a> › <a href="/waterstand/">Waterstanden</a> › {loc.naam}</nav>
  <h1>Waterstand {loc.naam}</h1>
  {ws && <p class="lead">Nu: <strong>{meter(ws.v)}</strong>{trend && <>, {trend}{delta !== null && trend !== "stabiel" && <> ({delta > 0 ? "+" : "−"}{Math.abs(delta)} cm in 24 uur)</>}</>}.</p>}
  {ws && <p class="muted bijgewerkt">Gemeten {dag(ws.t)} om {tijd(ws.t)} · bron: Rijkswaterstaat, meetpunt {ws.meetpuntNaam}</p>}

  <section class="kaarten">
    {ws && <div class="kaart"><span class="label">Waterstand nu</span><span class="waarde">{meter(ws.v).replace(" NAP", "")}</span><span class="sub">t.o.v. NAP · {tijd(ws.t)}</span></div>}
    {delta !== null && <div class="kaart"><span class="label">Afgelopen 24 uur</span><span class="waarde">{delta > 0 ? "+" : delta < 0 ? "−" : ""}{Math.abs(delta)} cm</span><span class="sub">{trend}</span></div>}
    {temp && <div class="kaart"><span class="label">Watertemperatuur</span><span class="waarde">{graden(temp.v)}</span><span class="sub">gemeten {metTijd(temp.t)}{tempBij && <> · bij {tempBij}</>}</span></div>}
  </section>

  {reeks.length >= 24 && <WaterstandGrafiek reeks={reeks} />}
  {weekMin && <p class="muted klein">Afgelopen 7 dagen: laagste {meter(weekMin.v)}, hoogste {meter(weekMax.v)}.</p>}

  {loc.intro && <><h2>Over het water bij {loc.naam}</h2><p>{loc.intro}</p></>}

  <h2>Veelgestelde vragen</h2>
  {faq.map((f) => <details><summary>{f.v}</summary><p>{f.a}</p></details>)}

  <p class="muted">Wat betekent een waterstand in m NAP? Lees <a href="/uitleg/nap">wat NAP is</a>.</p>

  {andere.length > 0 && <><h2>Andere waterstanden</h2><ul class="buren">{andere.map((l) => <li><a href={`/waterstand/${l.slug}`}>{l.naam}</a></li>)}</ul></>}
</Base>

<style>
  .kruimel { font-size: .85rem; margin-top: 18px; }
  .kruimel a { color: var(--muted); }
  .lead { font-size: 1.1rem; margin: 4px 0; }
  .bijgewerkt { font-size: .85rem; margin: 0 0 18px; }
  .kaarten { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .kaart { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; display: flex; flex-direction: column; }
  .kaart .label { font-size: .72rem; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .kaart .waarde { font-size: clamp(1.4rem, 5vw, 1.7rem); font-weight: 700; line-height: 1.2; margin: 4px 0 2px; }
  .kaart .sub { font-size: .85rem; color: var(--muted); }
  .klein { font-size: .85rem; }
  details { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; margin-bottom: 8px; }
  summary { cursor: pointer; font-weight: 600; }
  .buren { display: flex; flex-wrap: wrap; gap: 8px 18px; padding: 0; list-style: none; }
</style>
