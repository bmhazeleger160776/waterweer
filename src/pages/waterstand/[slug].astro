---
import fs from "node:fs";
import path from "node:path";
import Base from "../../layouts/Base.astro";
import WaterstandGrafiek from "../../components/WaterstandGrafiek.astro";
import { tijd, dag, dagKort, meter, graden, metTijd } from "../../lib/format.js";

export function getStaticPaths() {
  const root = process.cwd();
  const locaties = JSON.parse(fs.readFileSync(path.join(root, "data/locaties.json"), "utf8"));
  const metPagina = locaties.filter((l) => !l.rws?.getij && l.rws?.waterstand && fs.existsSync(path.join(root, `data/metingen/${l.slug}.json`)));
  return metPagina.map((loc) => ({
    params: { slug: loc.slug },
    props: {
      loc,
      data: JSON.parse(fs.readFileSync(path.join(root, `data/metingen/${loc.slug}.json`), "utf8")),
      zelfdeRivier: metPagina.filter((l) => l.slug !== loc.slug && l.rivier && l.rivier === loc.rivier),
      buren: (loc.dichtbij ?? []).map((s) => metPagina.find((l) => l.slug === s)).filter((l) => l && l.rivier !== loc.rivier),
    },
  }));
}

const { loc, data, zelfdeRivier, buren } = Astro.props;
const ws = data.waterstand;
const reeks = ws?.reeks ?? [];
const nu = ws ? Date.parse(ws.t) : null;
const dagGeleden = reeks.length ? reeks.reduce((a, b) => (Math.abs(Date.parse(b.t) - (nu - 864e5)) < Math.abs(Date.parse(a.t) - (nu - 864e5)) ? b : a)) : null;
const delta = ws && dagGeleden && Math.abs(Date.parse(dagGeleden.t) - (nu - 864e5)) < 3 * 3600e3 ? Math.round(ws.v - dagGeleden.v) : null;
const trend = delta === null ? null : Math.abs(delta) < 5 ? "stabiel" : delta > 0 ? "stijgend" : "dalend";
const weekMin = reeks.length ? reeks.reduce((a, b) => (b.v < a.v ? b : a)) : null;
const weekMax = reeks.length ? reeks.reduce((a, b) => (b.v > a.v ? b : a)) : null;
const vw = (ws?.verwachting ?? []).filter((p) => nu && Date.parse(p.t) > nu);
const dagFmt = new Intl.DateTimeFormat("nl-NL", { timeZone: "Europe/Amsterdam", weekday: "long", day: "numeric", month: "long" });
const dagKey = (t) => new Intl.DateTimeFormat("sv-SE", { timeZone: "Europe/Amsterdam" }).format(new Date(t));
const vwDagen = [...vw.reduce((m, p) => { const k = dagKey(p.t); const d = m.get(k) ?? { t: p.t, min: p.v, max: p.v }; d.min = Math.min(d.min, p.v); d.max = Math.max(d.max, p.v); return m.set(k, d); }, new Map()).values()];
const vwPiek = vw.length ? vw.reduce((a, b) => (b.v > a.v ? b : a)) : null;
const vwEind = vw.at(-1);
const vwTrend = ws && vwEind ? (Math.abs(vwEind.v - ws.v) < 10 ? "ongeveer gelijk blijven" : vwEind.v > ws.v ? `stijgen naar ${meter(vwEind.v)}` : `dalen naar ${meter(vwEind.v)}`) : null;
const HUB = { Rijn: "rijn", Waal: "waal", Nederrijn: "lek", Lek: "lek", IJssel: "ijssel", Maas: "maas", "Bergsche Maas": "maas" };
const temp = data.temperatuur;
const tempBij = temp && loc.rws?.temperatuur?.km > 2 ? (temp.meetpuntNaam || loc.rws.temperatuur.naam) : null;
const isMeer = loc.type === "meer";
const opRivier = loc.rivier && !isMeer ? ` (${loc.rivier})` : "";
const titel = `Waterstand ${loc.naam}${opRivier} vandaag – actueel ${isMeer ? "peil" : vw.length ? "en verwachting" : "en verloop"}`;
const omschrijving = ws
  ? `Waterstand ${loc.naam}: ${meter(ws.v)} (gemeten ${tijd(ws.t)})${trend ? `, ${trend}` : ""}. Verloop van de afgelopen 7 dagen, elk uur bijgewerkt met data van Rijkswaterstaat.`
  : `Actuele waterstand ${loc.naam}, elk uur bijgewerkt met data van Rijkswaterstaat.`;
const faq = [
  ws && { v: `Wat is de waterstand bij ${loc.naam}?`, a: `De laatst gemeten waterstand bij ${loc.naam} is ${meter(ws.v)} (${dag(ws.t)} om ${tijd(ws.t)}).${delta !== null ? ` Dat is ${Math.abs(delta)} cm ${delta >= 0 ? "hoger" : "lager"} dan 24 uur eerder.` : ""}` },
  vwTrend && { v: `Wat is de verwachting voor de waterstand bij ${loc.naam}?`, a: `Volgens de verwachting van Rijkswaterstaat zal de waterstand bij ${loc.naam} tot ${dagFmt.format(new Date(vwEind.t))} ${vwTrend}.${vwPiek && vwPiek.v > ws.v + 10 ? ` Het hoogste punt wordt verwacht op ${dagFmt.format(new Date(vwPiek.t))}: ${meter(vwPiek.v)}.` : ""} Verwachtingen kunnen nog veranderen.` },
  weekMin && { v: `Hoe veranderde de waterstand de afgelopen week?`, a: `De afgelopen 7 dagen lag de waterstand tussen ${meter(weekMin.v)} en ${meter(weekMax.v)}.` },
  temp && { v: `Wat is de watertemperatuur bij ${loc.naam}?`, a: `De laatst gemeten watertemperatuur is ${graden(temp.v)}${tempBij ? ` (gemeten bij ${tempBij})` : ""}.` },
].filter(Boolean);
const jsonLd = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${Astro.site}` },
    { "@type": "ListItem", position: 2, name: "Waterstanden", item: `${Astro.site}waterstand/` },
    { "@type": "ListItem", position: 3, name: `${loc.naam}${opRivier}`, item: `${Astro.site}waterstand/${loc.slug}` },
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<Base title={titel} description={omschrijving} canonical={`/waterstand/${loc.slug}`} jsonLd={jsonLd}>
  <nav class="kruimel muted"><a href="/">Home</a> › <a href="/waterstand/">Waterstanden</a> › {loc.naam}</nav>
  <h1>Waterstand {loc.naam}{opRivier && <>{" "}<span class="rivier">{loc.rivier}</span></>}</h1>
  {ws && <p class="lead">Nu: <strong>{meter(ws.v)}</strong>{trend && <>, {trend}{delta !== null && trend !== "stabiel" && <> ({delta > 0 ? "+" : "−"}{Math.abs(delta)} cm in 24 uur)</>}</>}.</p>}
  {ws && <p class="muted bijgewerkt">Gemeten {dag(ws.t)} om {tijd(ws.t)} · bron: Rijkswaterstaat, meetpunt {ws.meetpuntNaam}</p>}

  {ws && (
    <section class="hero" aria-label={`Waterstand ${loc.naam} nu`}>
      <p class="status">{trend ? `Nu: ${trend}` : "Laatste meting"}</p>
      <div class="hero-top">
        <div>
          <p class="hlabel">Waterstand {isMeer ? "" : `${loc.rivier ?? ""} `}bij {loc.naam}</p>
          <p class="hgroot">{meter(ws.v).replace(" NAP", "")}</p>
          <p class="hsub">t.o.v. NAP · {tijd(ws.t)}</p>
        </div>
        {delta !== null && (
          <div class="rechts">
            <p class="hlabel">Afgelopen 24 uur</p>
            <p class="hmidden">{delta > 0 ? "+" : delta < 0 ? "−" : ""}{Math.abs(delta)} cm</p>
            <p class="hsub">{trend}</p>
          </div>
        )}
      </div>
      {reeks.length >= 24 && <WaterstandGrafiek hero reeks={reeks} verwachting={vw} />}
    </section>
  )}

  <section class="kaarten">
    {weekMin && <div class="kaart"><span class="label">Laagste deze week</span><span class="waarde">{meter(weekMin.v).replace(" NAP", "")}</span><span class="sub">t.o.v. NAP</span></div>}
    {weekMax && <div class="kaart"><span class="label">Hoogste deze week</span><span class="waarde">{meter(weekMax.v).replace(" NAP", "")}</span><span class="sub">t.o.v. NAP</span></div>}
    {temp && <div class="kaart"><span class="label">Watertemperatuur</span><span class="waarde">{graden(temp.v)}</span><span class="sub">gemeten {metTijd(temp.t)}{tempBij && <> · bij {tempBij}</>}</span></div>}
  </section>

  {vwDagen.length > 0 && (
    <>
      <h2>Verwachting waterstand {loc.naam}</h2>
      <p>Rijkswaterstaat verwacht dat de waterstand bij {loc.naam} tot {dagFmt.format(new Date(vwEind.t))} zal {vwTrend}.{vwPiek && vwPiek.v > ws.v + 10 && <> Het hoogste punt: <strong>{meter(vwPiek.v)}</strong> op {dagFmt.format(new Date(vwPiek.t))}.</>}</p>
      <div class="tabelwrap"><table class="vwtabel">
        <thead><tr><th>Dag</th><th>Laagste</th><th>Hoogste</th></tr></thead>
        <tbody>{vwDagen.map((d) => <tr><td>{dagKort(d.t)}</td><td>{meter(d.min).replace(" NAP", "")}</td><td>{meter(d.max).replace(" NAP", "")}</td></tr>)}</tbody>
      </table></div>
      <p class="muted klein">Verwachte waterstand in m t.o.v. NAP, bron: Rijkswaterstaat. Een verwachting wordt minder zeker naarmate ze verder vooruit kijkt.</p>
    </>
  )}

  {loc.intro && <><h2>Over het water bij {loc.naam}</h2><p>{loc.intro}</p></>}

  <h2>Veelgestelde vragen</h2>
  {faq.map((f) => <details><summary>{f.v}</summary><p>{f.a}</p></details>)}

  <p class="muted">Wat betekent een waterstand in m NAP? Lees <a href="/uitleg/nap">wat NAP is</a>.</p>

  {zelfdeRivier.length > 0 && <><h2>Meer waterstanden {["IJssel", "Lek", "Waal", "Maas", "Rijn", "Nederrijn", "Bergsche Maas"].includes(loc.rivier) ? `langs de ${loc.rivier}` : ""}</h2><ul class="buren">{zelfdeRivier.map((l) => <li><a href={`/waterstand/${l.slug}`}>{l.naam}</a></li>)}</ul></>}
  {buren.length > 0 && <><h2>In de buurt</h2><ul class="buren">{buren.map((l) => <li><a href={`/waterstand/${l.slug}`}>{l.naam}{l.rivier && <span class="muted"> · {l.rivier}</span>}</a></li>)}</ul></>}
  {HUB[loc.rivier] && <p class="meer"><a href={`/waterstand/${HUB[loc.rivier]}`}>Waterstand {HUB[loc.rivier] === "lek" ? "Nederrijn en Lek" : loc.rivier === "Bergsche Maas" ? "Maas" : loc.rivier}: alle meetpunten →</a></p>}
  <p class="meer"><a href="/waterstand/" data-umami-event="alle-waterstanden">Alle waterstanden per rivier →</a></p>
</Base>

<style>
  .kruimel { font-size: .85rem; margin-top: 18px; }
  .kruimel a { color: var(--muted); }
  h1 .rivier { display: inline-block; vertical-align: middle; margin-left: 10px; font-family: "Inter", sans-serif; font-size: .9rem; font-weight: 600; letter-spacing: 0; color: var(--accent-dark); background: var(--accent-soft); padding: 4px 10px; border-radius: 999px; }
  .lead { font-size: 1.05rem; margin: 4px 0; }
  .bijgewerkt { font-size: .85rem; margin: 0 0 16px; }
  .hero { background: var(--accent); color: #fff; border-radius: 20px; padding: 20px 20px 14px; margin-bottom: 14px; }
  .hero p { margin: 0; }
  .status { font-size: .78rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--on-accent); margin-bottom: 8px !important; }
  .hero-top { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 10px; }
  .hlabel { font-size: .85rem; color: var(--on-accent); }
  .hgroot { font-family: var(--kop); font-size: clamp(2.4rem, 10vw, 3.2rem); font-weight: 700; line-height: 1; margin: 4px 0 !important; font-variant-numeric: tabular-nums; }
  .hmidden { font-size: 1.4rem; font-weight: 650; line-height: 1.1; margin: 4px 0 !important; font-variant-numeric: tabular-nums; }
  .hsub { font-size: .88rem; color: var(--on-accent); }
  .rechts { text-align: right; }
  .kaarten { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 8px; }
  @media (max-width: 520px) { .kaarten { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .kaart { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; display: flex; flex-direction: column; min-width: 0; }
  .kaart .label { font-size: .8rem; color: var(--muted); font-weight: 500; }
  .kaart .waarde { font-size: clamp(1.35rem, 5vw, 1.65rem); font-weight: 700; line-height: 1.2; margin: 6px 0 2px; font-variant-numeric: tabular-nums; }
  .kaart .sub { font-size: .82rem; color: var(--muted); }
  .klein { font-size: .85rem; }
  .tabelwrap { overflow-x: auto; }
  .vwtabel { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; font-variant-numeric: tabular-nums; }
  .vwtabel th, .vwtabel td { white-space: nowrap; text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .vwtabel th { font-size: .8rem; font-weight: 600; color: var(--muted); background: #f8fbfd; }
  .vwtabel tr:last-child td { border-bottom: 0; }
  .vwtabel td:first-child { font-weight: 600; }
  .meer { margin-top: 18px; font-weight: 600; }
  details { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 16px; margin-bottom: 8px; }
  summary { cursor: pointer; font-weight: 600; }
  details p { margin: 8px 0 2px; }
  .buren { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; list-style: none; }
  .buren li a { display: inline-block; padding: 8px 14px; background: var(--card); border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-weight: 500; }
  .buren li a:hover { border-color: var(--accent); }
</style>
