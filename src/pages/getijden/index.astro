---
import fs from "node:fs";
import path from "node:path";
import Base from "../../layouts/Base.astro";
import { REGIOS } from "../../lib/regios.js";
const root = process.cwd();
const locaties = JSON.parse(fs.readFileSync(path.join(root, "data/locaties.json"), "utf8"))
  .filter((l) => l.rws?.getij && fs.existsSync(path.join(root, `data/metingen/${l.slug}.json`)))
  .sort((a, b) => a.naam.localeCompare(b.naam, "nl"));
const SUB = {
  zeeland: "Grootste getijverschil van Nederland",
  "zuid-holland": "Scheveningen, Hoek van Holland en meer",
  "noord-holland": "Van Zandvoort tot Den Helder",
  wadden: "Eilanden, Waddenzee en wadlopen",
};
const regios = Object.entries(REGIOS).map(([slug, r]) => ({ slug, ...r, lijst: locaties.filter((l) => l.regioSlug === slug) }));
---
<Base title="Getijden Nederland – eb en vloed per plaats" description="Getijtabellen met hoog- en laagwater voor de hele Nederlandse kust, per plaats en elk uur bijgewerkt met data van Rijkswaterstaat." canonical="/getijden/">
  <nav class="kruimel muted"><a href="/">Home</a> › Getijden</nav>
  <h1>Getijden per plaats</h1>
  <p>Hoog- en laagwater voor {locaties.length} plaatsen langs de Nederlandse kust, met watertemperatuur en de actuele waterstand. Elk uur bijgewerkt met data van Rijkswaterstaat. Kies een regio of ga direct naar een plaats.</p>

  <ul class="tegels">
    {regios.map((r) => (
      <li><a href={`/getijden/${r.slug}`}>
        <strong>{r.naam}</strong>
        <span class="muted">{SUB[r.slug] ?? ""}</span>
        <span class="verder">{r.lijst.length} plaatsen →</span>
      </a></li>
    ))}
  </ul>

  {regios.filter((r) => r.lijst.length).map((r) => (
    <section>
      <h2><a href={`/getijden/${r.slug}`}>{r.h1}</a></h2>
      <ul class="chips">{r.lijst.map((l) => <li><a href={`/getijden/${l.slug}`}>{l.naam}</a></li>)}</ul>
    </section>
  ))}

  <p class="meer muted">Op zoek naar de waterstand van een rivier? Bekijk de <a href="/waterstand/">waterstanden van Rijn, Waal, IJssel en Maas</a>.</p>
</Base>
<style>
  .meer { margin-top: 32px; }
</style>
