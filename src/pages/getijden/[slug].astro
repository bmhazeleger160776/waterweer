---
import fs from "node:fs";
import path from "node:path";
import Base from "../../layouts/Base.astro";
import GetijGrafiek from "../../components/GetijGrafiek.astro";
import { jarenVoor } from "../../lib/jaar.js";
import { beaufort, richting, richtingKort, golfMeter, golfOordeel } from "../../lib/weer.js";
import { tijd, dag, dagKort, datumKey, meter, graden, metTijd } from "../../lib/format.js";

export function getStaticPaths() {
  const root = process.cwd();
  const locaties = JSON.parse(fs.readFileSync(path.join(root, "data/locaties.json"), "utf8"));
  return locaties
    .filter((l) => l.rws?.getij && fs.existsSync(path.join(root, `data/metingen/${l.slug}.json`)))
    .map((loc) => ({
      params: { slug: loc.slug },
      props: {
        loc,
        data: JSON.parse(fs.readFileSync(path.join(root, `data/metingen/${loc.slug}.json`), "utf8")),
        metPagina: locaties.filter((l) => l.rws?.getij && fs.existsSync(path.join(root, `data/metingen/${l.slug}.json`))).map((l) => l.slug),
        alle: locaties,
      },
    }));
}

const { loc, data, metPagina, alle } = Astro.props;
const nu = data.bijgewerkt;
const ext = data.getij?.extremen ?? [];
const volgendHW = ext.find((e) => e.soort === "HW" && e.t >= nu);
const volgendLW = ext.find((e) => e.soort === "LW" && e.t >= nu);
const eerste = [volgendHW, volgendLW].filter(Boolean).sort((a, b) => a.t.localeCompare(b.t));
const vandaagKey = datumKey(nu);
const vandaag = ext.filter((e) => datumKey(e.t) === vandaagKey);

// 7-dagentabel
const perDag = new Map();
for (const e of ext) {
  const k = datumKey(e.t);
  if (k < vandaagKey) continue;
  if (!perDag.has(k)) perDag.set(k, { iso: e.t, HW: [], LW: [] });
  perDag.get(k)[e.soort].push(e);
}
const dagen = [...perDag.values()].slice(0, 7);

// Gemeten vs voorspeld: verschil zegt iets over wind-opzet
let afwijking = null;
if (data.waterstand && data.getij?.reeks?.length) {
  const tm = Date.parse(data.waterstand.t);
  const dichtst = data.getij.reeks.reduce((a, b) => (Math.abs(Date.parse(b.t) - tm) < Math.abs(Date.parse(a.t) - tm) ? b : a));
  if (Math.abs(Date.parse(dichtst.t) - tm) < 30 * 60e3) afwijking = Math.round(data.waterstand.v - dichtst.v);
}

const temp = data.temperatuur;
const golf = data.golf, wind = data.wind;
const windTekst = wind ? `${beaufort(wind.snelheid)} Bft${typeof wind.richting === "number" ? ` uit het ${richting(wind.richting)}` : ""}` : null;
const tempBij = temp && loc.rws?.temperatuur?.km > 2 ? (temp.meetpuntNaam || loc.rws.temperatuur.naam) : null;
const tempOordeel = !temp ? null
  : temp.v < 15 ? "Koud water: zonder wetsuit raak je snel onderkoeld."
  : temp.v < 18 ? "Fris water, prima voor een korte duik."
  : temp.v < 21 ? "Aangename temperatuur om te zwemmen."
  : "Warm zeewater voor Nederlandse begrippen.";

const getijVerschil = (() => {
  const hw = vandaag.filter((e) => e.soort === "HW"), lw = vandaag.filter((e) => e.soort === "LW");
  if (!hw.length || !lw.length) return null;
  return Math.round(Math.max(...hw.map((e) => e.v)) - Math.min(...lw.map((e) => e.v)));
})();

const titel = `Getijden ${loc.naam} vandaag – eb, vloed en watertemperatuur`;
const omschrijving = volgendHW
  ? `Hoogwater ${loc.naam}: ${dagKort(volgendHW.t)} om ${tijd(volgendHW.t)}. Getijtabel voor 7 dagen, watertemperatuur${data.golf ? ", golfhoogte en wind" : " en waterstand"}, elk uur bijgewerkt.`
  : `Getijden, eb en vloed en watertemperatuur in ${loc.naam}, elk uur bijgewerkt met data van Rijkswaterstaat.`;

const faq = [
  volgendHW && {
    v: `Wanneer is het hoogwater in ${loc.naam}?`,
    a: `Het volgende hoogwater in ${loc.naam} is ${dag(volgendHW.t)} om ${tijd(volgendHW.t)} (${meter(volgendHW.v)}).${volgendLW ? ` Het volgende laagwater is om ${tijd(volgendLW.t)} (${meter(volgendLW.v)}).` : ""}`,
  },
  temp && {
    v: `Wat is de watertemperatuur in ${loc.naam}?`,
    a: `De laatst gemeten watertemperatuur is ${graden(temp.v)} (gemeten ${metTijd(temp.t)}). ${tempOordeel}`,
  },
  getijVerschil && {
    v: `Hoe groot is het verschil tussen eb en vloed in ${loc.naam}?`,
    a: `Vandaag is het verschil tussen het hoogste hoogwater en het laagste laagwater ongeveer ${(getijVerschil / 100).toFixed(1).replace(".", ",")} meter. Bij springtij is dat groter, bij doodtij kleiner.`,
  },
  golf && {
    v: `Hoe hoog zijn de golven bij ${loc.naam}?`,
    a: `De laatst gemeten golfhoogte bij ${golf.meetpuntNaam} is ${golfMeter(golf.v)} (${metTijd(golf.t)}). ${golfOordeel(golf.v)}${windTekst ? ` De wind is ${windTekst}.` : ""}`,
  },
].filter(Boolean);

const jsonLd = [
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${Astro.site}` },
      { "@type": "ListItem", position: 2, name: "Getijden", item: `${Astro.site}getijden/` },
      { "@type": "ListItem", position: 3, name: loc.regio, item: `${Astro.site}getijden/${loc.regioSlug}` },
      { "@type": "ListItem", position: 4, name: loc.naam, item: `${Astro.site}getijden/${loc.slug}` },
    ],
  },
  {
    "@context": "https://schema.org", "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
const jaartabellen = jarenVoor(loc.rws.getij.code);
const agendaUrl = `waterweer.nl/agenda/${loc.slug}.ics`;
const naamVan = (slug) => alle.find((l) => l.slug === slug)?.naam ?? slug;
---
<Base title={titel} description={omschrijving} canonical={`/getijden/${loc.slug}`} jsonLd={jsonLd}>
  <nav class="kruimel muted"><a href="/">Home</a> › <a href="/getijden/">Getijden</a> › <a href={`/getijden/${loc.regioSlug}`}>{loc.regio}</a> › {loc.naam}</nav>

  {data.voorbeeld && (
    <p class="melding">Dit is <strong>voorbeelddata</strong> (gesimuleerd getij). Draai <code>npm run fetch-data</code> voor echte data van Rijkswaterstaat.</p>
  )}

  <h1>Getijden {loc.naam}</h1>
  <p class="lead">
    {eerste[0] && <>Eerstvolgend {eerste[0].soort === "HW" ? "hoogwater" : "laagwater"}: <strong>{tijd(eerste[0].t)}</strong>{datumKey(eerste[0].t) !== vandaagKey && <> ({dagKort(eerste[0].t)})</>}. </>}
    {eerste[1] && <>Daarna {eerste[1].soort === "HW" ? "hoogwater" : "laagwater"} om <strong>{tijd(eerste[1].t)}</strong>{datumKey(eerste[1].t) !== vandaagKey && <> ({dagKort(eerste[1].t)})</>}. </>}
    {temp && <>Watertemperatuur: <strong>{graden(temp.v)}</strong>.</>}
  </p>
  <p class="muted bijgewerkt">Bijgewerkt {dag(nu)} om {tijd(nu)} · bron: Rijkswaterstaat, meetpunt {loc.rws.getij?.naam ?? data.getij?.meetpunt}</p>

  <section class="hero" aria-label={`Getij ${loc.naam} nu`}>
    {eerste[0] && (
      <>
        <p class="status">Nu: {eerste[0].soort === "HW" ? "opkomend water" : "afgaand water"}</p>
        <div class="hero-top">
          <div>
            <p class="hlabel">Volgend {eerste[0].soort === "HW" ? "hoogwater" : "laagwater"}</p>
            <p class="hgroot">{tijd(eerste[0].t)}</p>
            <p class="hsub">{datumKey(eerste[0].t) !== vandaagKey && <span>{dagKort(eerste[0].t)} · </span>}<span>{meter(eerste[0].v)}</span></p>
          </div>
          {eerste[1] && (
            <div class="rechts">
              <p class="hlabel">Daarna {eerste[1].soort === "HW" ? "hoogwater" : "laagwater"}</p>
              <p class="hmidden">{tijd(eerste[1].t)}</p>
              <p class="hsub">{datumKey(eerste[1].t) !== vandaagKey && <span>{dagKort(eerste[1].t)} · </span>}<span>{meter(eerste[1].v)}</span></p>
            </div>
          )}
        </div>
      </>
    )}
    {data.getij && <GetijGrafiek hero reeks={data.getij.reeks} extremen={ext} nu={nu} />}
  </section>

  <section class="kaarten">
    {temp && <div class="kaart"><span class="label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4a2 2 0 0 1 4 0v10a4 4 0 1 1-4 0z"/><path d="M12 9v7"/></svg>Watertemperatuur</span><span class="waarde">{graden(temp.v)}</span><span class="sub">gemeten {metTijd(temp.t)}{tempBij && <> · bij {tempBij}</>}</span></div>}
    {golf && <div class="kaart"><span class="label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 15c2.5-3 5-3 7.5 0s5 3 7.5 0 3.5-2 5-1"/><path d="M2 9c2.5-3 5-3 7.5 0s5 3 7.5 0 3.5-2 5-1"/></svg>Golfhoogte</span><span class="waarde">{golfMeter(golf.v)}</span><span class="sub">{golf.periode ? `periode ${String(golf.periode).replace(".", ",")} s · ` : ""}{tijd(golf.t)}</span></div>}
    {wind && <div class="kaart"><span class="label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h11a3 3 0 1 0-3-3"/><path d="M3 12h16a3 3 0 1 1-3 3"/><path d="M3 16h7"/></svg>Wind</span><span class="waarde">{beaufort(wind.snelheid)} Bft{typeof wind.richting === "number" && <> {richtingKort(wind.richting)}</>}</span><span class="sub">{String(wind.snelheid).replace(".", ",")} m/s · {tijd(wind.t)}</span></div>}
    {data.waterstand && <div class="kaart"><span class="label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18"/><path d="M8 7h4M8 11h4M8 15h4"/><path d="M3 18c3-2 6-2 9 0s6 2 9 0"/></svg>Waterstand nu</span><span class="waarde">{meter(data.waterstand.v)}</span>
      <span class="sub">{afwijking === null ? `gemeten ${tijd(data.waterstand.t)}` : afwijking === 0 ? "precies volgens voorspelling" : `${Math.abs(afwijking)} cm ${afwijking > 0 ? "hoger" : "lager"} dan voorspeld`}</span></div>}
  </section>

  <h2>Getijtabel {loc.naam} – komende 7 dagen</h2>
  <div class="tabelwrap">
    <table>
      <thead><tr><th>Dag</th><th>Hoogwater</th><th>Laagwater</th></tr></thead>
      <tbody>
        {dagen.map((d) => (
          <tr>
            <td>{dagKort(d.iso)}</td>
            <td>{d.HW.map((e) => <div class="ext"><strong>{tijd(e.t)}</strong> <span class="muted">{meter(e.v).replace(" NAP", "")}</span></div>)}</td>
            <td>{d.LW.map((e) => <div class="ext"><strong>{tijd(e.t)}</strong> <span class="muted">{meter(e.v).replace(" NAP", "")}</span></div>)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="muted klein">Hoogte in meters ten opzichte van NAP. Wind en luchtdruk kunnen de werkelijke waterstand tientallen centimeters laten afwijken.</p>
  {jaartabellen.length > 0 && <p class="jaarlink">{jaartabellen.map((j) => <a href={`/getijden/${loc.slug}/${j}`}>Getijtabel {loc.naam} {j} (heel jaar, printbaar) →</a>)}</p>}

  {loc.intro && <><h2>Over het water bij {loc.naam}</h2><p>{loc.intro}</p></>}

  {temp && (
    <>
      <h2>Watertemperatuur {loc.naam}</h2>
      <p>Het water bij {loc.naam} is nu {graden(temp.v)}{tempBij && <> (gemeten bij {tempBij}, het dichtstbijzijnde meetpunt van Rijkswaterstaat)</>}. {tempOordeel}</p>
    </>
  )}

  {(golf || wind) && (
    <>
      <h2>Golven en wind bij {loc.naam}</h2>
      <p>
        {golf && <>De golfhoogte is nu <strong>{golfMeter(golf.v)}</strong>{golf.periode && <> met een golfperiode van {String(golf.periode).replace(".", ",")} seconden</>}. In de afgelopen 24 uur lag die tussen {golfMeter(golf.min24)} en {golfMeter(golf.max24)}. {golfOordeel(golf.v)} </>}
        {wind && <>De wind is <strong>{windTekst}</strong> ({String(wind.snelheid).replace(".", ",")} m/s). </>}
      </p>
      <p class="muted klein">Gemeten door Rijkswaterstaat{golf && <>; golven bij {golf.meetpuntNaam} ({String(golf.km).replace(".", ",")} km)</>}{wind && <>; wind bij {wind.meetpuntNaam} ({String(wind.km).replace(".", ",")} km)</>}. Golfhoogte is de significante golfhoogte: de gemiddelde hoogte van de hoogste golven. Losse golven kunnen hoger zijn.</p>
    </>
  )}

  <section class="agendablok">
  <h2>Getijden {loc.naam} in je agenda</h2>
  <p>Zet alle hoog- en laagwaters van {loc.naam} voor de komende drie maanden in je agenda. De agenda werkt zichzelf bij.</p>
  <p class="agenda">
    <a class="knop" href={`https://calendar.google.com/calendar/render?cid=${encodeURIComponent(`webcal://${agendaUrl}`)}`}>Google Agenda</a>
    <a class="knop licht" href={`webcal://${agendaUrl}`}>iPhone, Mac of Outlook</a>
  </p>
  <p class="muted klein">Andere agenda? Abonneer je op dit adres: <code>https://{agendaUrl}</code></p>
  </section>

  <h2>Veelgestelde vragen</h2>
  {faq.map((f) => <details><summary>{f.v}</summary><p>{f.a}</p></details>)}

  <p class="meer muted">Eigen website, camping of strandpaviljoen? <a href="/widget/">Zet de getijden van {loc.naam} gratis op je site</a>.</p>
  <p class="meer muted">Meer weten? <a href="/uitleg/eb-en-vloed">Hoe werken eb en vloed?</a> · <a href="/uitleg/springtij-en-doodtij">Springtij en doodtij</a> · <a href="/uitleg/nap">Wat is NAP?</a>{loc.regioSlug === "wadden" && <> · <a href="/uitleg/wadlopen">Wadlopen</a></>}</p>

  {loc.dichtbij?.length > 0 && (
    <>
      <h2>Getijden in de buurt</h2>
      <ul class="buren">
        {loc.dichtbij.map((s) => metPagina.includes(s)
          ? <li><a href={`/getijden/${s}`}>{naamVan(s)}</a></li>
          : <li class="muted">{naamVan(s)} (binnenkort)</li>)}
      </ul>
    </>
  )}
</Base>

<style>
  .kruimel { font-size: .85rem; margin-top: 18px; }
  .kruimel a { color: var(--muted); }
  .melding { background: var(--warn-soft); color: var(--warn); border: 1px solid #f0d49c; border-radius: 10px; padding: 10px 14px; margin: 16px 0 0; font-size: .92rem; }
  .lead { font-size: 1.05rem; margin: 4px 0; }
  .bijgewerkt { font-size: .85rem; margin: 0 0 16px; }

  .hero { background: var(--accent); color: #fff; border-radius: 20px; padding: 20px 20px 14px; margin-bottom: 14px; }
  .hero p { margin: 0; }
  .status { font-size: .78rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--on-accent); margin-bottom: 8px !important; }
  .hero-top { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 10px; }
  .hlabel { font-size: .85rem; color: var(--on-accent); }
  .hgroot { font-family: var(--kop); font-size: clamp(2.6rem, 11vw, 3.4rem); font-weight: 700; line-height: 1; margin: 4px 0 4px !important; font-variant-numeric: tabular-nums; }
  .hmidden { font-size: 1.5rem; font-weight: 650; line-height: 1.1; margin: 4px 0 4px !important; font-variant-numeric: tabular-nums; }
  .hsub { font-size: .88rem; color: var(--on-accent); }
  .rechts { text-align: right; }
  .hsub span { white-space: nowrap; }
  .ext { white-space: nowrap; }
  .ext strong { font-weight: 600; }
  .ext .muted { font-size: .85em; }
  @media (max-width: 520px) {
    th, td { padding: 9px 8px; font-size: .9rem; }
    th:first-child, td:first-child { padding-left: 12px; }
    .hsub span { display: block; }
    .hmidden { font-size: 1.3rem; }
  }

  .kaarten { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 8px; }
  @media (max-width: 520px) { .kaarten { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .kaart { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; display: flex; flex-direction: column; min-width: 0; }
  .kaart .label { display: flex; align-items: center; gap: 6px; font-size: .8rem; color: var(--muted); font-weight: 500; }
  .kaart .label svg { width: 16px; height: 16px; flex: none; fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .kaart .waarde { font-size: clamp(1.35rem, 5vw, 1.65rem); font-weight: 700; line-height: 1.2; margin: 6px 0 2px; font-variant-numeric: tabular-nums; }
  .kaart .sub { font-size: .82rem; color: var(--muted); }

  .tabelwrap { overflow-x: auto; border-radius: var(--radius); }
  table { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  th, td { text-align: left; padding: 11px 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: .8rem; font-weight: 600; color: var(--muted); background: #f8fbfd; }
  td:first-child { white-space: nowrap; font-weight: 600; }
  tbody tr:nth-child(1) td { background: var(--accent-soft); }
  tr:last-child td { border-bottom: 0; }
  .klein { font-size: .85rem; }
  .jaarlink a { display: inline-block; font-weight: 600; text-decoration: none; padding: 6px 0; }
  .meer { font-size: .92rem; margin-top: 20px; }
  .agendablok { background: var(--accent-soft); border-radius: 18px; padding: 4px 20px 16px; margin-top: 40px; }
  .agendablok h2 { margin-top: 18px; }
  .agenda { display: flex; flex-wrap: wrap; gap: 8px; }
  .knop { display: inline-flex; align-items: center; min-height: 44px; padding: 10px 16px; border-radius: 10px; background: var(--accent); color: #fff; text-decoration: none; font-weight: 600; }
  .knop:hover { background: var(--accent-dark); color: #fff; }
  .knop.licht { background: #fff; color: var(--accent); border: 1px solid #b9d7ea; }
  .knop.licht:hover { background: #fff; color: var(--accent-dark); }
  code { font-size: .85em; word-break: break-all; }
  details { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 16px; margin-bottom: 8px; }
  summary { cursor: pointer; font-weight: 600; }
  details p { margin: 8px 0 2px; }
  .buren { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; list-style: none; }
  .buren li a { display: inline-block; padding: 8px 14px; background: var(--card); border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-weight: 500; }
  .buren li a:hover { border-color: var(--accent); }
  .buren li.muted { padding: 8px 4px; }
</style>
