---
import Base from "../layouts/Base.astro";
import WaterstandGrafiek from "../components/WaterstandGrafiek.astro";
import { hoogwaterStatus } from "../lib/hoogwater.js";
import { meter, tijd, dagKort } from "../lib/format.js";

const s = hoogwaterStatus();
const maand = new Intl.DateTimeFormat("nl-NL", { timeZone: "Europe/Amsterdam", month: "long", year: "numeric" }).format(new Date());
const opsomming = (lijst) => (lijst.length <= 1 ? lijst.join("") : `${lijst.slice(0, -1).join(", ")} en ${lijst.at(-1)}`);
const onderwerpTekst = opsomming(s.onderwerpen.map((o) => (o === "kust" ? "de kust" : o)));
const titel = s.actief
  ? `Hoogwater ${s.onderwerpen.includes("kust") && s.onderwerpen.length === 1 ? "aan de kust" : opsomming(s.onderwerpen.filter((o) => o !== "kust"))} – ${maand}: actuele standen en verwachting`
  : "Hoogwater nu? Actuele waterstanden van Rijn, Maas en de kust";
const omschrijving = s.actief
  ? `Hoogwater op ${onderwerpTekst}: actuele waterstanden, de verwachte piek van Rijkswaterstaat en wat er gebeurt. Elk uur bijgewerkt.`
  : "Is er hoogwater op de Rijn, de Maas of aan de kust? Actuele waterstanden, verwachting en grenzen, elk uur bijgewerkt met data van Rijkswaterstaat.";
const NIVEAU = { normaal: "normaal", verhoogd: "verhoogd: uiterwaarden lopen onder", hoog: "hoogwater" };
const faq = [
  { v: "Wanneer is er hoogwater bij Lobith?", a: "Vanaf ongeveer 12 meter boven NAP lopen de uiterwaarden langs Rijn, Waal, Nederrijn en IJssel onder. Vanaf 13 meter boven NAP geeft Rijkswaterstaat kleurcode geel. Een stand van 13 meter komt ongeveer eens per jaar voor." },
  { v: "Waar vind ik de officiële hoogwaterberichten?", a: "Rijkswaterstaat publiceert bij hoogwater status- en hoogwaterberichten met kleurcodes via het Waterbericht en waterinfo.rws.nl. Volg bij dreigend gevaar altijd de aanwijzingen van Rijkswaterstaat, de waterschappen, de gemeente en de veiligheidsregio." },
  { v: "Hoe lang duurt het voordat hoogwater van Lobith in de rest van het land is?", a: "Een hoogwatergolf stroomt via de Waal en de Nederrijn en Lek in ongeveer een tot twee dagen naar de Rijn-Maasmonding. Via de IJssel duurt het twee tot drie dagen voordat de golf het IJsselmeer bereikt." },
];
const jsonLd = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${Astro.site}` },
    { "@type": "ListItem", position: 2, name: "Hoogwater", item: `${Astro.site}hoogwater` },
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<Base title={titel} description={omschrijving} canonical="/hoogwater" jsonLd={jsonLd}>
  <nav class="kruimel muted"><a href="/">Home</a> › Hoogwater</nav>
  <h1>{s.actief ? `Hoogwater ${s.onderwerpen.includes("kust") && s.onderwerpen.length === 1 ? "aan de kust" : opsomming(s.onderwerpen.filter((o) => o !== "kust"))}` : "Is er nu hoogwater?"}</h1>

  <div class:list={["status", { actief: s.actief }]}>
    {s.actief
      ? <p><strong>Er is verhoogd water op {onderwerpTekst}.</strong> Hieronder de actuele standen en de verwachting van Rijkswaterstaat, elk uur bijgewerkt.</p>
      : <p><strong>Er is nu geen hoogwater</strong> op de Rijn en de Maas, en aan de kust is het water niet uitzonderlijk opgestuwd. Deze pagina wordt elk uur bijgewerkt; bij hoogwater staan hier de standen en de verwachting.</p>}
  </div>

  {s.rivieren.map((r) => (
    <section class="rivier">
      <h2><a href={`/waterstand/${r.hub}`}>Waterstand {r.rivier} bij {r.naam}</a></h2>
      <p>Nu <strong>{meter(r.ws.v)}</strong> ({tijd(r.ws.t)}), {NIVEAU[r.nu]}.{r.piek && r.piek.v > r.ws.v + 5 && <> Rijkswaterstaat verwacht een stijging tot <strong>{meter(r.piek.v)}</strong> op {dagKort(r.piek.t)}{r.verwacht !== r.nu && <>: {NIVEAU[r.verwacht]}</>}.</>}{r.piek && r.piek.v <= r.ws.v + 5 && <> De komende dagen wordt geen verdere stijging verwacht.</>}</p>
      {r.reeks.length >= 24 && <div class="hero"><WaterstandGrafiek hero reeks={r.reeks} verwachting={r.vw} /></div>}
      <p class="klein">Grenzen bij {r.naam}: vanaf {(r.verhoogd / 100).toFixed(2).replace(".", ",")} m +NAP verhoogd, vanaf {(r.hoog / 100).toFixed(2).replace(".", ",")} m +NAP hoogwater. <a href={`/waterstand/${r.hub}`}>Alle meetpunten langs de {r.rivier} →</a></p>
    </section>
  ))}

  <h2>Opwaaiing aan de kust</h2>
  <p>Bij harde wind uit zee komt het water hoger dan het getij voorspelt. Hieronder de plaatsen waar het verschil nu het grootst is. Vanaf ongeveer {s.grens} cm boven de voorspelling is er sprake van flinke opwaaiing; bij een zware storm kan dat oplopen tot meters. Lees meer over <a href="/uitleg/stormvloed">stormvloed en de stormvloedkeringen</a>.</p>
  <div class="tabelwrap">
    <table>
      <thead><tr><th>Plaats</th><th>Gemeten</th><th>T.o.v. getij</th></tr></thead>
      <tbody>{s.kust.slice(0, 6).map((k) => (
        <tr><td><a href={`/getijden/${k.l.slug}`}>{k.l.naam}</a></td><td>{meter(k.ws.v).replace(" NAP", "")} <span class="muted">· {tijd(k.ws.t)}</span></td><td>{k.opzet > 0 ? "+" : k.opzet < 0 ? "−" : ""}{Math.abs(k.opzet)} cm</td></tr>
      ))}</tbody>
    </table>
  </div>

  <h2>Wanneer is het hoogwater?</h2>
  <ul>
    <li><strong>Rijn bij Lobith:</strong> vanaf ongeveer 12 meter boven NAP lopen de uiterwaarden langs de grote rivieren onder. Vanaf 13 meter geeft Rijkswaterstaat kleurcode geel. Dat komt ongeveer eens per jaar voor. Het record is 16,93 meter, in 1926.</li>
    <li><strong>Maas:</strong> de Maas is een regenrivier en kan na veel regen in de Ardennen binnen een paar dagen sterk stijgen. Bij Venlo stond het water bij code geel in januari 2024 rond 15,4 meter boven NAP.</li>
    <li><strong>Kust:</strong> bij een zware storm uit het westen of noordwesten stuwt de wind het zeewater op. Bij een verwachte stand van 3 meter boven NAP bij Rotterdam sluit de Maeslantkering.</li>
  </ul>

  <h2>Veelgestelde vragen</h2>
  {faq.map((f) => <details><summary>{f.v}</summary><p>{f.a}</p></details>)}

  <p class="klein bron">Grenzen en kleurcodes: Rijkswaterstaat (statusberichten Rijn en hoogwaterberichten Maas). Metingen en verwachting: Rijkswaterstaat, elk uur bijgewerkt. Dit is geen officiële waarschuwing.</p>
</Base>
<style>
  .status { border-radius: var(--radius); padding: 4px 18px; margin: 12px 0 8px; background: #e8f6ee; border: 1px solid #bfe3cc; }
  .status.actief { background: var(--warn-soft); border-color: #f0d49c; }
  .hero { background: var(--accent); border-radius: 18px; padding: 16px 18px 10px; margin: 10px 0 6px; }
  .bron { margin-top: 24px; }
  td:first-child { font-weight: 600; }
  td { white-space: nowrap; }
</style>
