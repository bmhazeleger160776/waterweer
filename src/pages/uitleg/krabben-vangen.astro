const faq = [
  { v: "Wanneer kun je het best krabben vangen op het strand?", a: "Rond laagwater. Begin ongeveer anderhalf tot twee uur voor laagwater: dan ligt het meeste strand, de dijkvoet of de getijdenpoelen droog of ondiep, en heb je nog tijd voordat het water terugkomt. Bekijk de getijtabel van de plaats waar je bent." },
