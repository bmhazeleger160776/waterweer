---
const { title, description, canonical, jsonLd = [] } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const url = canonical ? site + canonical : undefined;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {url && <link rel="canonical" href={url} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {url && <meta property="og:url" content={url} />}
    <meta property="og:locale" content="nl_NL" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <style is:global>
      :root {
        --ink: #0f2230; --muted: #557083; --line: #dbe5ec; --bg: #f6f9fb; --card: #fff;
        --accent: #0b6fa4; --accent-soft: #e3f1f9; --warn: #9a5b00; --warn-soft: #fff4e0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: var(--ink); background: var(--bg);
      }
      * { box-sizing: border-box; }
      body { margin: 0; line-height: 1.55; }
      a { color: var(--accent); }
      .wrap { max-width: 860px; margin: 0 auto; padding: 0 20px; }
      header.site { background: var(--card); border-bottom: 1px solid var(--line); }
      header.site .wrap { display: flex; align-items: center; height: 56px; gap: 10px; }
      header.site a.logo { font-weight: 700; font-size: 1.15rem; text-decoration: none; color: var(--ink); }
      header.site a.logo span { color: var(--accent); }
      footer.site { margin-top: 56px; padding: 28px 0 40px; border-top: 1px solid var(--line); color: var(--muted); font-size: .9rem; }
      h1 { font-size: clamp(1.6rem, 4vw, 2.1rem); line-height: 1.2; margin: 24px 0 8px; }
      h2 { font-size: 1.25rem; margin: 36px 0 12px; }
      .muted { color: var(--muted); }
    </style>
  </head>
  <body>
    <header class="site"><div class="wrap"><a class="logo" href="/">water<span>weer</span>.nl</a></div></header>
    <main class="wrap"><slot /></main>
    <footer class="site"><div class="wrap">
      Data: Rijkswaterstaat (open data). Getijden zijn astronomische voorspellingen; door wind en luchtdruk kan de werkelijke waterstand afwijken.
      Gebruik deze site niet als enige bron voor navigatie of veiligheid.
    </div></footer>
  </body>
</html>
