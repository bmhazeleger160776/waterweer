---
import { hubJaren } from "../lib/jaar.js";
const getijJaar = hubJaren().at(-1);
const { title, description, canonical, jsonLd = [] } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const url = canonical ? site + canonical : undefined;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {url && <link rel="canonical" href={url} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {url && <meta property="og:url" content={url} />}
    <meta property="og:locale" content="nl_NL" />
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="4cd52cee-8cf8-4952-a4bc-baa2ebedfb28" data-domains="waterweer.nl"></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    <style is:global>
      @font-face { font-family: "Inter"; src: url(/fonts/inter.woff2) format("woff2"); font-weight: 100 900; font-display: swap; }
      @font-face { font-family: "Space Grotesk"; src: url(/fonts/space-grotesk-700.woff2) format("woff2"); font-weight: 600 700; font-display: swap; }
      :root {
        --ink: #10222e; --muted: #4f6878; --line: #dfe8ee; --bg: #f4f8fb; --card: #fff;
        --accent: #0a6aa1; --accent-dark: #06496f; --accent-soft: #e6f2f9; --on-accent: #cfe7f5; --sun: #ffd166;
        --warn: #9a5b00; --warn-soft: #fff4e0;
        --radius: 14px; --kop: "Space Grotesk", "Inter", system-ui, sans-serif;
        font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: var(--ink); background: var(--bg);
        font-feature-settings: "tnum" 1, "cv11" 1;
      }
      * { box-sizing: border-box; }
      body { margin: 0; line-height: 1.55; }
      a { color: var(--accent); text-underline-offset: 2px; }
      a:hover { color: var(--accent-dark); }
      .wrap { max-width: 880px; margin: 0 auto; padding: 0 20px; }
      h1, h2, h3 { font-family: var(--kop); letter-spacing: -.01em; }
      h1 { font-size: clamp(1.75rem, 5vw, 2.35rem); line-height: 1.1; margin: 22px 0 8px; }
      h2 { font-size: 1.3rem; line-height: 1.25; margin: 40px 0 12px; }
      .muted { color: var(--muted); }
      .kaartblok { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; }
      .kruimel { font-size: .85rem; margin-top: 18px; }
      .kruimel a { color: var(--muted); }
      .klein { font-size: .85rem; }
      .tabelwrap { overflow-x: auto; }
      table { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; font-variant-numeric: tabular-nums; }
      th, td { text-align: left; padding: 11px 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
      th { font-size: .8rem; font-weight: 600; color: var(--muted); background: #f8fbfd; white-space: nowrap; }
      tr:last-child td { border-bottom: 0; }
      @media (max-width: 520px) { th, td { padding: 9px 8px; font-size: .9rem; } th:first-child, td:first-child { padding-left: 12px; } }
      details { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 16px; margin-bottom: 8px; }
      summary { cursor: pointer; font-weight: 600; }
      details p { margin: 8px 0 2px; }
      .buren, .chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0; list-style: none; }
      .buren a, .chips a { display: inline-block; padding: 8px 14px; background: var(--card); border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-weight: 500; }
      .buren a:hover, .chips a:hover { border-color: var(--accent); }
      .tegels { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
      .tegels a { display: flex; flex-direction: column; gap: 4px; height: 100%; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; text-decoration: none; color: var(--ink); }
      .tegels a:hover { border-color: var(--accent); color: var(--ink); }
      .tegels strong { font-family: var(--kop); font-size: 1.1rem; }
      .tegels .muted { font-size: .9rem; }
      .tegels .verder { margin-top: auto; padding-top: 6px; color: var(--accent); font-weight: 600; font-size: .88rem; }
      h2 a { color: var(--ink); text-decoration: none; }
      h2 a:hover { color: var(--accent); }

      header.site { background: var(--card); border-bottom: 1px solid var(--line); position: relative; z-index: 5; }
      header.site .wrap { display: flex; align-items: center; justify-content: space-between; min-height: 60px; gap: 16px; }
      .logo { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--ink); font-family: var(--kop); font-weight: 700; font-size: 1.2rem; }
      .logo span { color: var(--accent); }
      .logo:hover { color: var(--ink); }
      nav.hoofd ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
      nav.hoofd a { display: block; padding: 10px 12px; border-radius: 10px; text-decoration: none; color: var(--ink); font-weight: 500; font-size: .95rem; }
      nav.hoofd a:hover { background: var(--accent-soft); color: var(--accent-dark); }
      details.menu { display: none; background: none; border: 0; padding: 0; margin: 0; border-radius: 0; }
      @media (max-width: 680px) {
        nav.hoofd { display: none; }
        details.menu { display: block; }
        details.menu summary { list-style: none; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; cursor: pointer; border-radius: 10px; }
        details.menu summary::-webkit-details-marker { display: none; }
        details.menu[open] summary { background: var(--accent-soft); }
        details.menu ul { position: absolute; left: 0; right: 0; top: 60px; margin: 0; padding: 8px 12px 14px; list-style: none; background: var(--card); border-bottom: 1px solid var(--line); box-shadow: 0 10px 24px rgba(16,34,46,.08); }
        details.menu a { display: block; padding: 12px 8px; text-decoration: none; color: var(--ink); font-weight: 600; border-bottom: 1px solid var(--line); }
        details.menu li:last-child a { border-bottom: 0; }
      }

      footer.site { margin-top: 64px; padding: 36px 0 44px; background: var(--card); border-top: 1px solid var(--line); color: var(--muted); font-size: .9rem; }
      footer.site .kolommen { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px 40px; }
      footer.site .disclaimer { max-width: 460px; margin: 0; }
      footer.site ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, auto)); gap: 6px 28px; }
      footer.site a { color: var(--ink); text-decoration: none; font-weight: 500; }
      footer.site a:hover { color: var(--accent); }
    </style>
  </head>
  <body>
    <header class="site"><div class="wrap">
      <a class="logo" href="/" aria-label="waterweer.nl, naar de homepage">
        <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#0a6aa1"/><path d="M5 18c4-5 7.3-5 11 0s7 5 11 0" fill="none" stroke="#fff" stroke-width="2.8" stroke-linecap="round"/></svg>
        <span style="color:inherit">water<span>weer</span></span>
      </a>
      <nav class="hoofd" aria-label="Hoofdmenu"><ul>
        <li><a href="/getijden/">Getijden</a></li><li><a href="/waterstand/">Waterstanden</a></li><li><a href="/uitleg/">Uitleg</a></li><li><a href="/widget/">Widget</a></li>
      </ul></nav>
      <details class="menu">
        <summary aria-label="Menu"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></summary>
        <ul>
          <li><a href="/getijden/">Getijden</a></li><li><a href="/waterstand/">Waterstanden</a></li><li><a href="/uitleg/">Uitleg</a></li><li><a href="/widget/">Gratis widget</a></li>
        </ul>
      </details>
    </div></header>
    <main class="wrap"><slot /></main>
    <footer class="site"><div class="wrap kolommen">
      <p class="disclaimer">Data: Rijkswaterstaat (open data), elk uur bijgewerkt. Getijden zijn astronomische voorspellingen; door wind en luchtdruk kan de werkelijke waterstand afwijken. Gebruik deze site niet als enige bron voor navigatie of veiligheid.</p>
      <ul>
        <li><a href="/getijden/">Getijden</a></li><li><a href="/getijden/zeeland">Zeeland</a></li>
        <li><a href="/waterstand/">Waterstanden</a></li><li><a href="/getijden/zuid-holland">Zuid-Holland</a></li>
        <li><a href="/uitleg/">Uitleg</a></li><li><a href="/getijden/noord-holland">Noord-Holland</a></li>
        <li><a href="/widget/">Gratis widget</a></li><li><a href="/getijden/wadden">Wadden</a></li>
        {getijJaar && <li><a href={`/getijtabel/${getijJaar}`}>Getijtabel {getijJaar}</a></li>}
      </ul>
    </div></footer>
  </body>
</html>
