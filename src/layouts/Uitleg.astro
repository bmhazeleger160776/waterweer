---
import Base from "./Base.astro";
import { UITLEG } from "../lib/uitleg.js";
const { slug, title, description, faq = [] } = Astro.props;
const pagina = UITLEG.find((u) => u.slug === slug);
const jsonLd = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${Astro.site}` },
    { "@type": "ListItem", position: 2, name: "Uitleg", item: `${Astro.site}uitleg/` },
    { "@type": "ListItem", position: 3, name: pagina.kort, item: `${Astro.site}uitleg/${slug}` },
  ] },
  { "@context": "https://schema.org", "@type": "Article", headline: pagina.titel, inLanguage: "nl-NL", publisher: { "@type": "Organization", name: "waterweer.nl" } },
  ...(faq.length ? [{ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })) }] : []),
];
---
<Base title={title} description={description} canonical={`/uitleg/${slug}`} jsonLd={jsonLd}>
  <nav class="kruimel muted"><a href="/">Home</a> › <a href="/uitleg/">Uitleg</a> › {pagina.kort}</nav>
  <article class="uitleg"><slot /></article>
  {faq.length > 0 && <><h2>Veelgestelde vragen</h2>{faq.map((f) => <details><summary>{f.v}</summary><p>{f.a}</p></details>)}</>}
  <h2>Meer uitleg</h2>
  <ul class="chips">{UITLEG.filter((u) => u.slug !== slug).map((u) => <li><a href={`/uitleg/${u.slug}`}>{u.titel}</a></li>)}</ul>
</Base>
<style>
  .uitleg :global(.klein) { font-size: .85rem; color: var(--muted); }
  .uitleg :global(.kader) { background: var(--accent-soft); border-radius: 12px; padding: 12px 16px; margin: 16px 0; }
</style>
